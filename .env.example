# Copy to .env.local for `vercel dev`. In production set these in Vercel > Project > Settings > Environment Variables.
# Never commit real values.

# Google AI Studio key (https://aistudio.google.com/apikey). Main provider.
GEMINI_API_KEY=
# Groq key (https://console.groq.com/keys). Backup when Gemini is rate-limited or down.
GROQ_API_KEY=

# Model IDs. Change these when providers retire models; no code change needed.
# Tried in order; each model has its own free quota, so a second one adds headroom.
GEMINI_MODELS=gemini-3.8-flash,gemini-3.5-flash-lite
GEMINI_EMBED_MODEL=gemini-embedding-001
GROQ_MODEL=openai/gpt-oss-120b

# Upstash Redis (free tier, https://console.upstash.com). Shared store for the per-person hourly cap.
# Adding Upstash from the Vercel Marketplace sets KV_REST_API_URL and KV_REST_API_TOKEN instead; both work.
# If unset, the cap falls back to per-instance memory (fine for local dev, leaky in production).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# AI requests allowed per person (per IP) per hour.
HOURLY_CAP=60

# Comma-separated origins allowed to call /api. Localhost is always allowed outside production.
ALLOWED_ORIGINS=https://vubicle.com,https://www.vubicle.com
